    "dssc.identity.verify_trust_anchor.v1": [
      "policy_snapshot_id",
      "vp_token",
      "credential_type",
      "issuer_id",
      "subject_id",
      "assurance_level",
      "attestation_class",
      "valid_from",
      "valid_until",
      "revocation_status"
    ]
  },
  "deny_reason_codes": [
    "DENY_CREDENTIAL_EXPIRED",
    "DENY_CREDENTIAL_REVOKED",
    "DENY_ATTESTATION_LEVEL_INSUFFICIENT",
    "DENY_TRUST_ANCHOR_UNVERIFIED",
    "PSC_BUNDLE_COMMIT_MISMATCH"
