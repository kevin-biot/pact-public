{
  "schema_version": "1.0",
  "domain": "dssc-catalog-discovery",
  "thresholds": {
    "overall_min_pass_rate": 1,
    "require_critical_pass": true
  },
  "cases": [
    {
      "id": "case_1",
      "phrase": "Publish new offering metadata into catalog scope.",
      "expect": "dssc.catalog.publish_offering.v1",
      "critical": true
    },
    {
      "id": "case_2",
      "phrase": "Update existing offering metadata and lifecycle state.",
      "expect": "dssc.catalog.update_offering.v1",
      "critical": true
    },
    {
      "id": "case_3",
      "phrase": "Remove/deprecate offering from discoverable catalog set.",
      "expect": "dssc.catalog.remove_offering.v1",
      "critical": true
    },
    {
      "id": "case_4",
      "phrase": "Query offering metadata in bounded discovery profile.",
      "expect": "dssc.catalog.query_offering.v1",
      "critical": true
    }
  ]
}
