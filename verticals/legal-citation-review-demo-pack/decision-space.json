{
  "schema_version": "1.0",
  "domain": "legal-citation-review",
  "pack_id": "legal-citation-review-demo-0.1.0",
  "version": "0.1.0",
  "out_of_scope_behavior": "escalate",
  "state_model": {
    "states": ["ingress", "validated", "classified", "reviewed", "responded", "rejected", "escalated"],
    "initial_state": "ingress",
    "terminal_states": ["responded", "rejected", "escalated"]
  },
  "intent_resource_map": {
    "legal.citation.review.align.v1": ["LegalCitationReviewDecision"]
  },
  "required_fields_by_intent": {
    "legal.citation.review.align.v1": [
      "jurisdiction",
      "review_date",
      "source_refs",
      "draft_claims"
    ]
  },
  "deny_reason_codes": [
    "DENY_MISSING_CITATION",
    "DENY_UNSUPPORTED_CLAIM",
    "DENY_JURISDICTION_MISMATCH",
    "DENY_EFFECTIVE_DATE_MISMATCH"
  ]
}
