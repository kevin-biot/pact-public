@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix emd: <https://pact.example/ontology/economic-measurement-drift/> .

emd:IntentShape
  a sh:NodeShape ;
  sh:targetClass emd:EconomicMeasurementDecision ;
  sh:property [
    sh:path emd:intentClass ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:message "intentClass is required"
  ] ;
  sh:property [
    sh:path emd:baselineStandard ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:message "baselineStandard is required"
  ] ;
  sh:property [
    sh:path emd:currentStandard ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:message "currentStandard is required"
  ] ;
  sh:property [
    sh:path emd:driftVector ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:message "driftVector is required"
  ] .
