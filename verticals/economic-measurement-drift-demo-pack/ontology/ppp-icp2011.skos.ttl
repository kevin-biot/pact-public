@prefix emd: <https://pact.example/ontology/economic-measurement-drift/> .

emd:ICP2011Scheme a skos:ConceptScheme ;
  dct:title "ICP 2011 Synthetic PPP Concepts" ;
  dct:source <https://www.worldbank.org/en/programs/icp/brief/reports> .

