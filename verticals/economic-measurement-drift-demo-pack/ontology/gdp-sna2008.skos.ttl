@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix emd: <https://pact.example/ontology/economic-measurement-drift/> .

emd:SNA2008Scheme a skos:ConceptScheme ;
  dct:title "SNA 2008 Synthetic GDP Concepts" ;
  dct:source <https://unstats.un.org/unsd/nationalaccount/docs/SNA2008.pdf> .

emd:GDPDefinitionSNA2008 a skos:Concept ;
  skos:inScheme emd:SNA2008Scheme ;
  skos:prefLabel "Gross Domestic Product definition (SNA 2008)" ;
  skos:scopeNote "Synthetic concept anchor for governance-drift demo; use source extract for provenance and lineages." .
