      "expect": "economic.coverage_drift.assess.v1",
      "critical": true
    },
    {
      "id": "recommend",
      "phrase": "issue non binding stability review recommendation",
      "expect": "economic.stability.review_recommendation.v1",
      "critical": true
    },
