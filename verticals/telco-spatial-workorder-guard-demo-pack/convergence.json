{
  "schema_version": "1.0",
  "domain": "telco-spatial-workorder-guard",
  "thresholds": {
    "overall_min_pass_rate": 1.0,
    "require_critical_pass": true
  },
  "cases": [
    {
      "id": "inside_scope",
      "phrase": "retune radios inside authorized work order polygon",
      "expect": "telco.ran.workorder.spatial.execute.v1",
      "critical": true
    },
    {
      "id": "outside_scope",
      "phrase": "retune radio outside polygon",
      "expect": "telco.ran.workorder.spatial.execute.v1",
      "critical": true
    },
    {
      "id": "out_scope_intent",
      "phrase": "adjust customer billing",
      "expect": "customer_billing_adjustment",
      "critical": false
    }
  ]
}
